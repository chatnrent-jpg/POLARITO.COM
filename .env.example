# Alpaca market data (server only, never NEXT_PUBLIC_*). Read-only use.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_DATA_FEED=iex

# Polarito login gate (server only, never NEXT_PUBLIC_*)
# Local setup:
#   1. Copy this file to .env.local (gitignored).
#   2. Choose your own username and a strong password. Do not commit them.
#   3. Generate a signing secret:  openssl rand -hex 32
#   4. Restart `npm run dev` / `npm start`.
# Fail-closed: if any of these three are missing, nobody can sign in.
POLARITO_AUTH_USER=
POLARITO_AUTH_PASSWORD=
POLARITO_AUTH_SECRET=

# SPY desk (page /spy): SPY long-timeframe readings, the contract the dry-run engine would pick, a MANUAL option ticket
# at any reading, a manual Close, and the AUTO practice trader (switch on /spy, default OFF). DRY RUN ONLY: it reads market data (GET-only Alpaca client) and changes a saved
# dry-run record; no code in this repository can send an order. OFF unless exactly 1.
# POLARITO_SPY_DESK=1
# Data keys (read-only use): ALPACA_LIVE_KEY_ID / ALPACA_LIVE_SECRET_KEY, or ALPACA_API_KEY_ID / ALPACA_API_SECRET_KEY.
# ALPACA_LIVE_KEY_ID=
# ALPACA_LIVE_SECRET_KEY=
# Where the dry-run position is kept: a Redis-over-HTTPS store (Vercel Marketplace: Upstash Redis), which sets these two
# for you. Without it the page still shows the readings and says the manual actions are off.
# (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN are accepted instead.)
# Local development only: SPY_DESK_STORE=memory.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Auto practice trader scheduler: Vercel Cron calls GET /api/spy/auto-run on weekdays after the close (vercel.json) and sends
# "Authorization: Bearer $CRON_SECRET" by itself. Set it yourself in Vercel > Project > Settings > Environment Variables
# (Production), at least 32 characters, e.g. the output of: openssl rand -hex 32. Unset or short = the route refuses everything.
# CRON_SECRET=
# SPY_DECISION_TIMEFRAME=M
# SPY_LIVE_BUDGET=1000
# SPY_STOCK_FEED=sip
# SPY_OPTIONS_FEED=indicative

# ---------------------------------------------------------------------------
# Live switches. KEPT OFF and INERT: nothing in this repository sends an order, so none of these can place one.
# They stay so a future live SPY options executor starts from fail-closed settings. Anything other than exactly "1"
# is OFF. Leave POLARITO_LIVE_TRADING_ENABLED unset.
# ---------------------------------------------------------------------------
# Opt in to the live account (live keys + live host). Read-only on its own.
# POLARITO_LIVE_ACCOUNT=1
# Would allow real orders. Unset.
# POLARITO_LIVE_TRADING_ENABLED=1
# Shared kill switch: any value other than empty/0/false/no/off kills.
POLARITO_BROKER_KILL=0
# Live Auto on/off (POST /api/broker/live/auto) is OFF by default and kept in the KV store above.
# Paper flag kept for the shared gate; it also does nothing without order code.
POLARITO_PAPER_TRADING_ENABLED=0
# Key diagnostic (GET /api/diag/alpaca-keys) also inspects these paper keys without calling them.
# ALPACA_PAPER_KEY_ID=
# ALPACA_PAPER_SECRET_KEY=
