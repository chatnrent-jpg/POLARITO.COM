# Alpaca market data (server only — never NEXT_PUBLIC_*)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_DATA_FEED=iex

# Alpaca PAPER trading (server only — never NEXT_PUBLIC_*). Use PAPER keys only.
# The paper adapter is hard-wired to https://paper-api.alpaca.markets; the live host is only
# reachable through the separate, opt-in LIVE CASH variables further down. Orders are only
# possible when ENABLED=1 and the
# kill switch is off. KILL: any value other than empty/0/false/no/off stops all orders.
ALPACA_PAPER_KEY_ID=
ALPACA_PAPER_SECRET_KEY=
POLARITO_PAPER_TRADING_ENABLED=0
POLARITO_BROKER_KILL=0

# Scheduled paper runner (server only). vercel.json calls /api/cron/paper-run on
# weekdays at 21:30 UTC (after the US close). The route authenticates with
# `Authorization: Bearer $CRON_SECRET`; Vercel sends it automatically when
# CRON_SECRET is set. Generate one:  openssl rand -hex 32   (min 16 chars)
# No secret => the route refuses everyone.
CRON_SECRET=
# Up to 10 tickers, separated by commas (spaces are fine). Empty => the runner refuses to run.
POLARITO_PAPER_WATCHLIST=
# Shares per entry (default 1). That is all you need to set.
POLARITO_PAPER_QTY=1
# What the runner trades: "stock" (default) or "options". Options mode buys ONE
# long-dated (365+ days) call on +1 or put on -1 per ticker, sells to close on
# 0 / flip / near expiry, and never touches plain stock positions. Switch only
# when the Alpaca paper account has no leftover stock orders or positions in the watchlist.
# POLARITO_PAPER_INSTRUMENT=stock
# "mirror" = live mirror: Alpaca follows POLARITO's SPY polarity tick by tick with long/short
# SHARES (same signal and decision code as the dashboard sim; no delay, hold or filter).
# Ticks come from .github/workflows/mirror-run.yml calling /api/cron/mirror-run. Options mode
# stays available (set "options") but is off while mirror is on.
# POLARITO_MIRROR_QTY=10              # shares per entry (the dashboard's default is 10)
# POLARITO_MIRROR_MAX_SHARES=100      # hard cap on the position; QTY above it is reduced
# POLARITO_MIRROR_DAILY_LOSS_PCT=2    # down this much on the day: flatten SPY, stand aside until next session
# Contracts per entry in options mode (default 1, max 10).
# POLARITO_OPTIONS_CONTRACTS=1
# Options mode daily loss stop: account down this % on the day => sell every option and stand aside
# until the next session. Default 1, allowed 0.25-10 (anything else falls back to 1). Options mode only;
# the browser sim and mirror mode do not use it.
# POLARITO_OPTIONS_DAILY_LOSS_PCT=1
# Optional: POLARITO_PAPER_SIZING=risk sizes by POLARITO_PAPER_RISK_PCT (0.05-2) instead.
# POLARITO_PAPER_SIZING=fixed
# POLARITO_PAPER_RISK_PCT=0.5

# ---------------------------------------------------------------------------
# LIVE CASH (real money). SHIPPED OFF: with none of these set the app is paper-only exactly as
# before and never reads the ALPACA_LIVE_* keys or contacts the live host. Live uses SEPARATE
# keys; the paper keys are never used for live. See the README for the go-live checklist.
# ---------------------------------------------------------------------------
# Live Alpaca keys (server only, Vercel env vars; never in chat or the repo).
# ALPACA_LIVE_KEY_ID=
# ALPACA_LIVE_SECRET_KEY=
# Switch 1 - opt in to the live account (live keys + live URL). Exactly "1". On its own this is
# READ-ONLY: the pick observes, logs what it would do and the site shows the live account.
# POLARITO_LIVE_ACCOUNT=1
# Switch 2 - allow REAL orders. Exactly "1"; anything else keeps live in observe mode.
# POLARITO_BROKER_KILL=1 (the shared kill switch above) stops live orders too.
# POLARITO_LIVE_TRADING_ENABLED=1
# Live Auto on/off (the switch in the live block of the order ticket card at polarito.com). It is OFF at deploy and is kept in a
# Redis-over-HTTPS store (Vercel Marketplace: Upstash Redis), which sets these two for you. Without a
# store Auto stays OFF and cannot be switched on. With Auto OFF the runner places no entries, re-entries
# or signal closes; the 1% stop-out, the end-of-day flatten and manual Close still run.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN are accepted instead.)
# Limits (src/lib/liveLimits.ts, LIVE_LIMITS): up to 3 stocks at once, 33% of equity per position (whole
# shares), long only, 1% whole-account daily stop, one automatic entry per ticker per day.
# Select the pick runner (/api/cron/pick-run, .github/workflows/pick-run.yml). This is the
# deployment-wide instrument switch, so it turns the daily paper/options/mirror runs OFF here.
# POLARITO_PAPER_INSTRUMENT=pick
# Live-only watchlist, up to 10 tickers (the paper POLARITO_PAPER_WATCHLIST is never used for live).
# POLARITO_LIVE_WATCHLIST=AAPL,MSFT,NVDA,AMZN,AVGO,GOOGL,GOOG,TSLA,JPM,WMT
# Shares per entry before the cap reduces it (default 1, max 1000). It is also the default share count
# of the order ticket's default share count in live mode. Manual buy (POST /api/broker/live/buy) needs no new variable: it
# uses POLARITO_LIVE_ACCOUNT=1 + POLARITO_LIVE_TRADING_ENABLED=1, obeys POLARITO_BROKER_KILL, and only
# buys tickers on POLARITO_LIVE_WATCHLIST with the same cap/stop settings as the runner.
# POLARITO_LIVE_QTY=1
# Max size of one position as % of equity (default 33, allowed 5-33: it can only lower the 33% limit).
# POLARITO_LIVE_MAX_POSITION_PCT=33
# Daily account stop: down this % on the day => flatten and no re-entry until the next session.
# Default 1, allowed 0.25-10; a bad value falls back to 1.
# POLARITO_LIVE_DAILY_LOSS_PCT=1
# Automatic entries not before this New York time (default 10:00, 09:30-15:30).
# POLARITO_LIVE_PICK_START=10:00
# Flatten and stop entering at this New York time (default 15:55, 12:00-15:59). "off" holds overnight.
# POLARITO_LIVE_FLATTEN_AT=15:55
# The live account is long only. When a Reverse reading ranks above a Drive one: "aside" (default)
# stops filling slots at that point, "next" skips it and takes the next eligible Drive stock instead.
# POLARITO_LIVE_LONG_ONLY_FALLBACK=aside

# SPY desk (page /spy): SPY long-timeframe readings, the contract the dry-run engine would pick, a MANUAL option ticket
# for Neutral readings and a manual Close. DRY RUN ONLY: it reads market data (GET-only Alpaca client) and changes a saved
# dry-run record; it has no order path. OFF unless exactly 1.
# POLARITO_SPY_DESK=1
# Data keys (read-only use): ALPACA_LIVE_KEY_ID / ALPACA_LIVE_SECRET_KEY, or ALPACA_API_KEY_ID / ALPACA_API_SECRET_KEY.
# Where the dry-run position is kept: the same KV_REST_API_URL / KV_REST_API_TOKEN Redis as the live Auto switch. Without
# it the page still shows the readings and says the manual actions are off. Local development only: SPY_DESK_STORE=memory.
# SPY_DECISION_TIMEFRAME=M
# SPY_LIVE_BUDGET=1000
# SPY_STOCK_FEED=sip
# SPY_OPTIONS_FEED=indicative

# Polarito login gate (server only — never NEXT_PUBLIC_*)
# Local setup:
#   1. Copy this file to .env.local (gitignored).
#   2. Choose your own username and a strong password. Do not commit them.
#   3. Generate a signing secret:  openssl rand -hex 32
#   4. Restart `npm run dev` / `npm start`.
# Fail-closed: if any of these three are missing, nobody can sign in.
POLARITO_AUTH_USER=
POLARITO_AUTH_PASSWORD=
POLARITO_AUTH_SECRET=

# Optional public (non-secret) build flags
# NEXT_PUBLIC_BASE_PATH=
# NEXT_PUBLIC_BARS_ENDPOINT=/api/bars
# NEXT_PUBLIC_HIDE_DEV_TOOLS=1
