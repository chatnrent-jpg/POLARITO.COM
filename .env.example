# Alpaca market data (server only — never NEXT_PUBLIC_*)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_DATA_FEED=iex

# Polarito login gate (server only — never NEXT_PUBLIC_*)
# Local setup:
#   1. Copy this file to .env.local (gitignored).
#   2. Choose your own username and a strong password. Do not commit them.
#   3. Generate a signing secret:  openssl rand -hex 32
#   4. Restart `npm run dev` / `npm start`.
# Fail-closed: if any of these three are missing, nobody can sign in.
POLARITO_AUTH_USER=
POLARITO_AUTH_PASSWORD=
POLARITO_AUTH_SECRET=

# Optional public (non-secret) build flags
# NEXT_PUBLIC_BASE_PATH=
# NEXT_PUBLIC_BARS_ENDPOINT=/api/bars
# NEXT_PUBLIC_HIDE_DEV_TOOLS=1
