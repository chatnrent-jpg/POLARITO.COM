<?php
/**
 * Polarito server secrets for Name.com.
 *
 * INSTALL
 *   1. Copy this file to /home/YOUR_CPANEL_USER/polarito-secrets.php
 *      (ONE LEVEL ABOVE public_html — not inside public_html, not inside /out).
 *   2. Paste the same Alpaca values you use in local .env.local.
 *   3. In File Manager, Permissions = 0600 (owner read/write only).
 *
 * DO NOT
 *   - Prefix these names with NEXT_PUBLIC_ (that would put them in browser JS).
 *   - Upload this file into public_html or the static /out folder.
 *   - Commit the filled-in copy to git.
 *
 * Name.com has no Next.js env-var panel. This PHP return array is the
 * server-side config. Apache SetEnv in a public .htaccess is weaker: that
 * file is web-tree readable and would still leak if PHP stops executing.
 */
if (!defined("POLARITO_BRIDGE")) {
    http_response_code(403);
    header("Content-Type: text/plain; charset=utf-8");
    echo "Forbidden";
    exit;
}

return array(
    "ALPACA_API_KEY_ID" => "PASTE_ALPACA_KEY_ID_HERE",
    "ALPACA_API_SECRET_KEY" => "PASTE_ALPACA_SECRET_HERE",
    "ALPACA_DATA_FEED" => "iex",
);
